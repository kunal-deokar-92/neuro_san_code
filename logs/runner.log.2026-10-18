ties': {'query': {'type': 'string', 'description': 'Query for retrieval'}, 'urls': {'type': 'array', 'items': {'type': 'string'}, 'description': 'List of URLs to retrieve information from'}}, 'required': ['query']}}, 'wikimedia_media_search': {'class': 'neuro_san_studio.coded_tools.wikimedia_media_search.WikimediaMediaSearch', 'description': '\n        Searches Wikimedia Commons for media files (images, audio, video) and returns direct URLs with proper file extensions.\nThis tool is excellent for finding high-quality, properly licensed multimedia content from Wikimedia Commons.\nSupports searching for images, audio files (mp3, ogg, flac, wav), and video files (webm, ogv, mp4).\n        ', 'parameters': {'type': 'object', 'properties': {'query': {'type': 'string', 'description': "The search query with KEYWORDS ONLY (no conversational phrases). Extract key terms from user request. \n                    Examples: 'nature video' (NOT 'show me nice nature video'), 'Einstein' (NOT 'photos of Einstein'), 'rain sound' (NOT 'find me rain sounds').\n                    For videos, include 'video', 'timelapse', or 'animation'. For audio, include 'sound' or 'audio'."}, 'media_type': {'type': 'string', 'description': "Type of media to search for: 'image', 'audio', 'video', or 'all' (default: 'image')"}, 'limit': {'type': 'int', 'description': 'Maximum number of results to return (default: 1, maximum: 10)'}, 'offset': {'type': 'int', 'description': 'Result offset for pagination (default: 0). Use 10, 20, 30, etc. to get different sets of results from the same query.'}}, 'required': ['query']}}, 'ddgs_search': {'class': 'neuro_san_studio.coded_tools.ddgs_search.DdgsSearch', 'description': 'Performs a web search using DDGS Search.', 'parameters': {'type': 'object', 'properties': {'search_terms': {'type': 'string', 'description': 'The query string or keywords to search for.'}}, 'required': ['search_terms']}}, 'web_fetch': {'class': 'neuro_san_studio.coded_tools.web_fetch.WebFetch', 'description': 'Fetches the content of a URL and returns its plain-text body along with metadata. Supports HTML pages and PDF documents.', 'parameters': {'type': 'object', 'properties': {'url': {'type': 'string', 'description': 'The URL to fetch. Must use http or https scheme and be at most 250 characters.'}, 'allowed_domains': {'type': 'array', 'items': {'type': 'string'}, 'description': 'Optional list of domains to allow. If set, only URLs whose domain matches one of these will be fetched.'}, 'blocked_domains': {'type': 'array', 'items': {'type': 'string'}, 'description': 'Optional list of domains to block. URLs whose domain matches one of these will be rejected.'}, 'max_content_chars': {'type': 'int', 'description': 'Maximum number of characters to return from the fetched content. Defaults to 20000.'}}, 'required': ['url']}}, 'read_file': {'class': 'neuro_san_studio.coded_tools.file_management.read_file.ReadFile', 'description': 'Reads the contents of a local text file (with optional line range and char cap) and returns the text plus metadata. Access is restricted by operator-configured allow/block lists for paths and extensions; the LLM cannot influence those lists.', 'parameters': {'type': 'object', 'properties': {'file_path': {'type': 'string', 'description': 'Absolute or relative path to the file to read.'}, 'start_line': {'type': 'int', 'description': '1-based line number to start reading from. Defaults to 1.'}, 'end_line': {'type': 'int', 'description': '1-based line number to stop reading at (inclusive). Defaults to end of file.'}, 'max_content_chars': {'type': 'int', 'description': 'Maximum number of characters to return. Defaults to 20000.'}}, 'required': ['file_path']}}, 'write_file': {'class': 'neuro_san_studio.coded_tools.file_management.write_file.WriteFile', 'description': 'Creates or overwrites a local text file with the given content. Access is restricted by operator-configured allow/block lists for paths and extensions; the LLM cannot influence those lists. Overwriting an existing file and creating missing parent directories both require explicit opt-in flags.', 'parameters': {'type': 'object', 'properties': {'file_path': {'type': 'string', 'description': 'Absolute or relative path to the file to write.'}, 'content': {'type': 'string', 'description': 'Text content to write to the file (UTF-8).'}, 'overwrite': {'type': 'boolean', 'description': 'Set true to replace an existing file. Defaults to false; writing to an existing path without it fails with file_already_exists.'}, 'create_parents': {'type': 'boolean', 'description': 'Set true to create missing parent directories (mkdir -p). Defaults to false; a missing parent fails with parent_not_found.'}}, 'required': ['file_path', 'content']}}}", "user_id": "None", "Timestamp": "2026-10-18T18:07:15.379838", "source": "Http Server", "message_type": "Other", "request_id": "request-8"}
