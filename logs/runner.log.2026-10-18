aint for the evaluation (default is 60 seconds).'}}, 'required': ['code']}, tags=['langchain_tool'], metadata={'title': 'Wolfram Language Evaluator', 'readOnlyHint': True, 'destructiveHint': False, 'idempotentHint': False, 'openWorldHint': True}, response_format='content_and_artifact', coroutine=<bound method McpToolErrorHandler.async_invoke of <neuro_san.internals.run_context.langchain.mcp.mcp_tool_error_handler.McpToolErrorHandler object at 0x00000258E1AD5AF0>>), StructuredTool(name='WolframAlpha', description='Use natural language queries with Wolfram|Alpha to get up-to-date computational results about entities in chemistry, physics, geography, history, art, astronomy, and more.', args_schema={'type': 'object', 'properties': {'query': {'type': 'string', 'description': 'Wolfram Alpha query'}}, 'required': ['query']}, tags=['langchain_tool'], metadata={'title': 'Wolfram|Alpha', 'readOnlyHint': True, 'destructiveHint': False, 'idempotentHint': False, 'openWorldHint': False}, response_format='content_and_artifact', coroutine=<bound method McpToolErrorHandler.async_invoke of <neuro_san.internals.run_context.langchain.mcp.mcp_tool_error_handler.McpToolErrorHandler object at 0x00000258E1CA0DA0>>)]", "user_id": "None", "Timestamp": "2026-10-18T18:07:23.917401", "source": "Http Server", "message_type": "Other", "request_id": "request-8"}
